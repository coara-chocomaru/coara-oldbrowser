<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.CoaraBrowser" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorPrimaryDark">@color/colorPrimaryVariant</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:alertDialogTheme">@style/Theme.CoaraBrowser.Dialog</item>
        <item name="roundButtonStyle">@style/Widget.Coara.RoundButton</item>
        <item name="chipStyle">@style/Widget.Coara.Chip.Filter</item>
    </style>


    <style name="Theme.CoaraBrowser.FullDialog" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
        <item name="roundButtonStyle">@style/Widget.Coara.RoundButton</item>
        <item name="chipStyle">@style/Widget.Coara.Chip.Filter</item>
    </style>

    <style name="Theme.CoaraBrowser.Transparent" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="Theme.CoaraBrowser.Touchpad" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorAccent">@color/colorPrimary</item>
    </style>

    <style name="Theme.CoaraBrowser.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/colorPrimary</item>
        <item name="android:windowBackground">@drawable/bg_dialog_round</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="Theme.CoaraBrowser.BottomSheet" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <style name="Animation.CoaraBrowser.BottomSheet" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <style name="Widget.Coara.RoundButton" parent="android:Widget.Material.Button">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Coara.TextButton" parent="Widget.Coara.RoundButton">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:minWidth">48dp</item>
    </style>

    <style name="Widget.Coara.Chip.Filter" parent="android:Widget">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="NumButtonBase" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:elevation">2dp</item>
    </style>
    <style name="NumScientificButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#DCEBFF</item>
        <item name="android:textColor">#102A43</item>
    </style>
    <style name="NumDigitButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#F8FAFC</item>
        <item name="android:textColor">#111827</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="NumOperatorButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#1D4ED8</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">20sp</item>
    </style>
    <style name="NumAccentButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#0F766E</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NumClearButton" parent="NumButtonBase">
        <item name="android:backgroundTint">#B91C1C</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="NumEqualButton" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">#15803D</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:elevation">3dp</item>
    </style>
    
</resources>
